#: usr/lib/linuxmint/mintupgrade/checks.py:32
#, python-format
msgid ""
"The package repositories need to point towards the new release (%s/%s)."
msgstr "Os repositorios de paquetes deben apuntar á nova versión (%s/%s)."

#: usr/lib/linuxmint/mintupgrade/checks.py:34
msgid "This should have be done by the Upgrade Tool already."
msgstr "A ferramenta de anovación xa debería ter feito isto."

#: usr/lib/linuxmint/mintupgrade/checks.py:35
msgid "Were the repositories modified since?"
msgstr "Modificáronse os repositorios desde entón?"

#: usr/lib/linuxmint/mintupgrade/checks.py:36
msgid "Re-run the Upgrade tool so that it migrates the repositories again."
msgstr ""
"Execute de novo a ferramenta de anovación para que volva migrar os "
"repositorios."

#: usr/lib/linuxmint/mintupgrade/checks.py:143
msgid "Linux Mint version"
msgstr "Versión de Linux Mint"

#: usr/lib/linuxmint/mintupgrade/checks.py:143
msgid "Checking your version of Linux Mint..."
msgstr "Comprobando a versión de Linux Mint..."

#: usr/lib/linuxmint/mintupgrade/checks.py:151
msgid ""
"Your version of Linux Mint is unknown. /etc/linuxmint/info is missing."
msgstr ""
"Descoñécese a versión de Linux Mint. Falta o ficheiro /etc/linuxmint/info."

#: usr/lib/linuxmint/mintupgrade/checks.py:168
#, python-format
msgid "Your version of Linux Mint is '%s'. Only %s can be upgraded to %s."
msgstr "A súa versión de Linux Mint é «%s». Só se pode anovar de %s a %s."

#: usr/lib/linuxmint/mintupgrade/checks.py:174
#, python-format
msgid "Your edition of Linux Mint is '%s'. It cannot be upgraded to %s."
msgstr "A súa edición de Linux Mint é «%s». Non se pode anovar a %s."

#: usr/lib/linuxmint/mintupgrade/checks.py:180
#, python-format
msgid "Your architecture of Linux Mint is '%s'. It cannot be upgraded."
msgstr "A arquitectura do seu sistema Linux Mint é «%s». Non se pode anovar."

#: usr/lib/linuxmint/mintupgrade/checks.py:187
msgid "Power source"
msgstr "Fonte de alimentación"

#: usr/lib/linuxmint/mintupgrade/checks.py:187
msgid "Checking the power source..."
msgstr "Comprobando a fonte de alimentación..."

#: usr/lib/linuxmint/mintupgrade/checks.py:192
msgid "Connect the computer to a power source before attempting to upgrade."
msgstr ""
"Conecte o equipo a unha fonte de alimentación antes de tentar anovar o "
"sistema."

#: usr/lib/linuxmint/mintupgrade/checks.py:198
msgid "System snapshots"
msgstr "Instantáneas do sistema"

#: usr/lib/linuxmint/mintupgrade/checks.py:198
msgid "Checking system snapshots..."
msgstr "Comprobando as instantáneas do sistema..."

#: usr/lib/linuxmint/mintupgrade/checks.py:203
msgid ""
"If the upgrade isn't successful, a system snapshot will allow you to go back "
"in time and revert all the changes."
msgstr ""
"Se a anovación non se completa correctamente, unha instantánea do sistema "
"permitiralle volver a un estado anterior e desfacer todos os cambios."

#: usr/lib/linuxmint/mintupgrade/checks.py:204
msgid "Press 'Fix' to perform a system snapshot."
msgstr "Prema «Corrixir» para crear unha instantánea do sistema."

#: usr/lib/linuxmint/mintupgrade/checks.py:220
msgid "APT cache"
msgstr "Caché de APT"

#: usr/lib/linuxmint/mintupgrade/checks.py:220
msgid "Checking the APT cache..."
msgstr "Comprobando a caché de APT..."

#: usr/lib/linuxmint/mintupgrade/checks.py:238
msgid ""
"Your package cache can't refresh correctly. Run 'apt update' and fix the "
"errors it displays."
msgstr ""
"Non se pode actualizar correctamente a caché de paquetes. Execute «apt "
"update» e corrixa os erros que aparezan."

#: usr/lib/linuxmint/mintupgrade/checks.py:247
msgid ""
"Some of your packages are broken. Run 'apt install -f' to fix the issue."
msgstr ""
"Algúns dos seus paquetes teñen dependencias sen resolver. Execute «apt "
"install -f» para solucionar o problema."

#: usr/lib/linuxmint/mintupgrade/checks.py:258
msgid ""
"Your operating system is not up to date. Apply available updates before "
"attempting the upgrade."
msgstr ""
"O seu sistema operativo non está actualizado. Aplique as actualizacións "
"dispoñíbeis antes de tentar anovar o sistema."

#: usr/lib/linuxmint/mintupgrade/checks.py:279
msgid "The following operations need to be performed:"
msgstr "É necesario realizar as seguintes operacións:"

#: usr/lib/linuxmint/mintupgrade/checks.py:281
#: usr/lib/linuxmint/mintupgrade/checks.py:503
msgid "Package"
msgstr "Paquete"

#: usr/lib/linuxmint/mintupgrade/checks.py:281
msgid "Operation"
msgstr "Operación"

#: usr/lib/linuxmint/mintupgrade/checks.py:283
msgid "needs to be installed"
msgstr "Debe instalarse"

#: usr/lib/linuxmint/mintupgrade/checks.py:285
msgid "needs to be removed"
msgstr "Debe eliminarse"

#: usr/lib/linuxmint/mintupgrade/checks.py:314
#: usr/lib/linuxmint/mintupgrade/checks.py:603
msgid "Package repositories"
msgstr "Repositorios de paquetes"

#: usr/lib/linuxmint/mintupgrade/checks.py:314
msgid "Checking package repositories..."
msgstr "Comprobando os repositorios de paquetes..."

#: usr/lib/linuxmint/mintupgrade/checks.py:328
msgid ""
"The following sources are defined in DEB822 format. This format isn't "
"supported yet."
msgstr ""
"As seguintes fontes están definidas no formato DEB822. A ferramenta aínda "
"non admite este formato."

#: usr/lib/linuxmint/mintupgrade/checks.py:334
msgid "Backup and then delete these files to continue."
msgstr ""
"Faga unha copia de seguridade destes ficheiros e despois elimíneos para "
"continuar."

#: usr/lib/linuxmint/mintupgrade/checks.py:362
msgid ""
"The following repositories do not explicitly support your version of Linux "
"Mint."
msgstr ""
"Os seguintes repositorios non indican expresamente que sexan compatíbeis coa "
"súa versión de Linux Mint."

#: usr/lib/linuxmint/mintupgrade/checks.py:370
msgid "These repositories need to be disabled."
msgstr "É necesario desactivar estes repositorios."

#: usr/lib/linuxmint/mintupgrade/checks.py:383
msgid "Your APT policy is incorrect."
msgstr "A política de APT non é correcta."

#: usr/lib/linuxmint/mintupgrade/checks.py:384
msgid "Reboot your computer."
msgstr "Reinicie o equipo."

#: usr/lib/linuxmint/mintupgrade/checks.py:392
#: usr/lib/linuxmint/mintupgrade/checks.py:409
#, python-format
msgid "%s is unreachable"
msgstr "Non se pode acceder a %s"

#: usr/lib/linuxmint/mintupgrade/checks.py:414
#, python-format
msgid "%s is not up to date. Switch to a different mirror."
msgstr "%s non está actualizado. Cambie a outro servidor espello."

#: usr/lib/linuxmint/mintupgrade/checks.py:422
#, python-format
msgid "%s does not support %s"
msgstr "%s non admite %s"

#: usr/lib/linuxmint/mintupgrade/checks.py:426
msgid "The following problems were found:"
msgstr "Detectáronse os seguintes problemas:"

#: usr/lib/linuxmint/mintupgrade/checks.py:468
msgid "Held packages"
msgstr "Paquetes retidos"

#: usr/lib/linuxmint/mintupgrade/checks.py:468
msgid "Looking for held packages..."
msgstr "Buscando paquetes retidos..."

#: usr/lib/linuxmint/mintupgrade/checks.py:474
msgid "The following packages are held:"
msgstr "Os seguintes paquetes están retidos:"

#: usr/lib/linuxmint/mintupgrade/checks.py:481
msgid "Held packages can break the upgrade."
msgstr "Os paquetes retidos poden facer fallar a anovación."

#: usr/lib/linuxmint/mintupgrade/checks.py:495
msgid "Foreign packages"
msgstr "Paquetes de procedencia externa"

#: usr/lib/linuxmint/mintupgrade/checks.py:495
msgid "Looking for foreign packages..."
msgstr "Buscando paquetes de procedencia externa..."

#: usr/lib/linuxmint/mintupgrade/checks.py:501
msgid ""
"The following packages need to be downgraded back to official versions:"
msgstr ""
"É necesario volver ás versións oficiais anteriores dos seguintes paquetes:"

#: usr/lib/linuxmint/mintupgrade/checks.py:503
msgid "Installed Version"
msgstr "Versión instalada"

#: usr/lib/linuxmint/mintupgrade/checks.py:503
msgid "Official version"
msgstr "Versión oficial"

#: usr/lib/linuxmint/mintupgrade/checks.py:503
msgid "Archive"
msgstr "Arquivo"

#: usr/lib/linuxmint/mintupgrade/checks.py:508
msgid "Otherwise these packages can create conflicts."
msgstr "De non facelo, estes paquetes poden provocar conflitos."

#: usr/lib/linuxmint/mintupgrade/checks.py:524
#: usr/lib/linuxmint/mintupgrade/checks.py:564
msgid "Orphan packages"
msgstr "Paquetes orfos"

#: usr/lib/linuxmint/mintupgrade/checks.py:524
msgid "Looking for orphan packages..."
msgstr "Buscando paquetes orfos..."

#: usr/lib/linuxmint/mintupgrade/checks.py:546
msgid "The following packages do not exist in the repositories:"
msgstr "Os seguintes paquetes non se atopan nos repositorios:"

#: usr/lib/linuxmint/mintupgrade/checks.py:552
msgid "In some rare cases orphan packages can interfere with the upgrade."
msgstr ""
"En casos pouco frecuentes, os paquetes orfos poden interferir na anovación."

#: usr/lib/linuxmint/mintupgrade/checks.py:553
msgid ""
"If you decide to uninstall some of these packages press 'Check again' after "
"their removal."
msgstr ""
"Se decide desinstalar algún destes paquetes, prema «Comprobar de novo» "
"despois de eliminalos."

#: usr/lib/linuxmint/mintupgrade/checks.py:554
msgid "Press 'OK' to continue with the upgrade."
msgstr "Prema «Aceptar» para continuar coa anovación."

#: usr/lib/linuxmint/mintupgrade/checks.py:564
msgid "Removing newly orphaned packages..."
msgstr "Eliminando os paquetes que quedaron orfos tras a anovación..."

#: usr/lib/linuxmint/mintupgrade/checks.py:603
msgid "Pointing to the new release..."
msgstr "Configurando os repositorios para a nova versión..."

#: usr/lib/linuxmint/mintupgrade/checks.py:642
msgid "Upgrade simulation"
msgstr "Simulación da anovación"

#: usr/lib/linuxmint/mintupgrade/checks.py:642
msgid "Simulating upgrade to check hard disk space and potential issues..."
msgstr ""
"Simulando a anovación para comprobar o espazo no disco duro e detectar "
"posibles problemas..."

#: usr/lib/linuxmint/mintupgrade/checks.py:681
msgid "The simulation was not successful."
msgstr "A simulación non se completou correctamente."

#: usr/lib/linuxmint/mintupgrade/checks.py:682
msgid "Upgrading would remove the following important packages:"
msgstr "A anovación eliminaría os seguintes paquetes importantes:"

#: usr/lib/linuxmint/mintupgrade/checks.py:683
msgid "Unwanted removals"
msgstr "Eliminacións non desexadas"

#: usr/lib/linuxmint/mintupgrade/checks.py:687
msgid ""
"This is a sign that something is wrong and needs to be fixed before going "
"further."
msgstr ""
"Isto indica que hai algún problema que é necesario solucionar antes de "
"continuar."

#: usr/lib/linuxmint/mintupgrade/checks.py:689
msgid "Recommended solution"
msgstr "Solución recomendada"

#: usr/lib/linuxmint/mintupgrade/checks.py:690
msgid "Use apt-get in a terminal to troubleshoot and solve the issue."
msgstr ""
"Utilice apt-get nun terminal para diagnosticar e solucionar o problema."

#: usr/lib/linuxmint/mintupgrade/checks.py:691
msgid "Don't hesitate to seek help on the forums and the chat room."
msgstr "Non dubide en pedir axuda nos foros e na sala de conversa."

#: usr/lib/linuxmint/mintupgrade/checks.py:693
msgid "Additional information"
msgstr "Información adicional"

#: usr/lib/linuxmint/mintupgrade/checks.py:694
msgid "The information below might help solve the issue."
msgstr "A información seguinte pode axudar a solucionar o problema."

#: usr/lib/linuxmint/mintupgrade/checks.py:695
#: usr/lib/linuxmint/mintupgrade/checks.py:707
msgid "Kept packages"
msgstr "Paquetes que non se actualizarán"

#: usr/lib/linuxmint/mintupgrade/checks.py:696
#: usr/lib/linuxmint/mintupgrade/checks.py:711
msgid "Removed packages"
msgstr "Paquetes que se eliminarán"

#: usr/lib/linuxmint/mintupgrade/checks.py:697
#: usr/lib/linuxmint/mintupgrade/checks.py:710
msgid "Added packages"
msgstr "Paquetes que se engadirán"

#: usr/lib/linuxmint/mintupgrade/checks.py:698
#: usr/lib/linuxmint/mintupgrade/checks.py:706
#, python-format
msgid "Packages updated: %d, added: %d , kept: %d, deleted: %d"
msgstr ""
"Paquetes previstos: %d por actualizar, %d por engadir, %d sen actualizar e "
"%d por eliminar"

#: usr/lib/linuxmint/mintupgrade/checks.py:701
msgid "Upgrading will perform the following changes."
msgstr "A anovación realizará os seguintes cambios."

#: usr/lib/linuxmint/mintupgrade/checks.py:709
msgid ""
"Note: Ideally, no packages should be kept. This might indicate an issue."
msgstr ""
"Nota: o ideal sería que non quedase ningún paquete sen actualizar. Isto "
"podería indicar un problema."

#: usr/lib/linuxmint/mintupgrade/checks.py:713
msgid ""
"Go through the list above and make sure you are happy with the removals "
"before going further with the upgrade."
msgstr ""
"Revise a lista anterior e asegúrese de estar de acordo coas eliminacións "
"antes de continuar coa anovación."

#: usr/lib/linuxmint/mintupgrade/checks.py:812
#, python-format
msgid "You need %s on '%s' but only have %s. You must free an additional %s."
msgstr ""
"Precísanse %s en «%s», pero só hai %s dispoñíbeis. Debe liberar outros %s."

#: usr/lib/linuxmint/mintupgrade/checks.py:816
#, python-format
msgid "Download size: %s. Additional space needed: %s."
msgstr "Tamaño da descarga: %s. Espazo adicional necesario: %s."

#: usr/lib/linuxmint/mintupgrade/checks.py:822
msgid "Package download"
msgstr "Descarga de paquetes"

#: usr/lib/linuxmint/mintupgrade/checks.py:822
msgid "Downloading packages..."
msgstr "Descargando paquetes..."

#: usr/lib/linuxmint/mintupgrade/checks.py:834
msgid "An error occurred while downloading the packages."
msgstr "Produciuse un erro ao descargar os paquetes."

#: usr/lib/linuxmint/mintupgrade/checks.py:841
msgid "Session inhibition"
msgstr "Prevención de interrupcións da sesión"

#: usr/lib/linuxmint/mintupgrade/checks.py:841
msgid "Inhibiting session..."
msgstr "Activando a prevención de interrupcións da sesión..."

#: usr/lib/linuxmint/mintupgrade/checks.py:850
msgid "Upgrade preparation"
msgstr "Preparación da anovación"

#: usr/lib/linuxmint/mintupgrade/checks.py:850
msgid "Preparing the upgrade..."
msgstr "Preparando a anovación..."

#: usr/lib/linuxmint/mintupgrade/checks.py:879
msgid "Upgrade phase"
msgstr "Fase de anovación"

#: usr/lib/linuxmint/mintupgrade/checks.py:879
msgid "Upgrading the system..."
msgstr "Anovando o sistema..."

#: usr/lib/linuxmint/mintupgrade/checks.py:896
#: usr/lib/linuxmint/mintupgrade/checks.py:902
msgid "An issue was detected during the upgrade."
msgstr "Detectouse un problema durante a anovación."

#: usr/lib/linuxmint/mintupgrade/checks.py:921
#, python-format
msgid "%d packages still need to be updated (%d kept, %d deleted)"
msgstr ""
"Aínda quedan %d paquetes por actualizar (%d que se manterán sen actualizar e "
"%d que se eliminarán)"

#: usr/lib/linuxmint/mintupgrade/checks.py:927
msgid "Final phase"
msgstr "Fase final"

#: usr/lib/linuxmint/mintupgrade/checks.py:927
msgid "Finalizing the upgrade..."
msgstr "Finalizando a anovación..."

#: usr/lib/linuxmint/mintupgrade/checks.py:946
#, python-format
msgid "%s could not be installed."
msgstr "Non se puido instalar %s."

#: usr/lib/linuxmint/mintupgrade/checks.py:953
msgid "mint-meta-codecs could not be installed."
msgstr "Non se puido instalar mint-meta-codecs."

#: usr/lib/linuxmint/mintupgrade/checks.py:973
#: usr/lib/linuxmint/mintupgrade/checks.py:992
msgid "The following packages could not be installed:"
msgstr "Non se puideron instalar os seguintes paquetes:"

#: usr/lib/linuxmint/mintupgrade/checks.py:1059
msgid "/etc/fstab was modified during the upgrade."
msgstr "O ficheiro /etc/fstab foi modificado durante a anovación."

#: usr/lib/linuxmint/mintupgrade/checks.py:1060
msgid ""
"To ensure a successful boot, the upgrade tool restored your original "
"/etc/fstab"
msgstr ""
"Para asegurar un arranque correcto, a ferramenta de anovación restaurou o "
"ficheiro /etc/fstab orixinal."

#: usr/lib/linuxmint/mintupgrade/checks.py:1061
msgid "A copy of the modified file was saved as /etc/fstab.upgraded"
msgstr ""
"Gardouse unha copia do ficheiro modificado co nome /etc/fstab.upgraded."

#: usr/lib/linuxmint/mintupgrade/mintupgrade.py:71
#: usr/lib/linuxmint/mintupgrade/mintupgrade.py:292 generate_desktop_files:26
#: usr/share/linuxmint/mintupgrade/mintupgrade.ui.h:16
msgid "Upgrade Tool"
msgstr "Ferramenta de anovación"

#: usr/lib/linuxmint/mintupgrade/mintupgrade.py:82
#: usr/share/linuxmint/mintupgrade/mintupgrade.ui.h:2
#, python-format
msgid "Upgrade to %s"
msgstr "Anovar a %s"

#: usr/lib/linuxmint/mintupgrade/mintupgrade.py:98
msgid "Preferences"
msgstr "Preferencias"

#: usr/lib/linuxmint/mintupgrade/mintupgrade.py:103
#: usr/lib/linuxmint/mintupgrade/mintupgrade.py:291
msgid "About"
msgstr "Sobre"

#: usr/lib/linuxmint/mintupgrade/mintupgrade.py:108
msgid "Quit"
msgstr "Saír"

#: usr/lib/linuxmint/mintupgrade/mintupgrade.py:152
msgid "Phase 1: Preparation"
msgstr "Fase 1: preparación"

#: usr/lib/linuxmint/mintupgrade/mintupgrade.py:153
msgid ""
"A series of tests will now be performed to prepare the computer for the "
"upgrade."
msgstr ""
"Agora realizaranse varias comprobacións para preparar o equipo para a "
"anovación."

#: usr/lib/linuxmint/mintupgrade/mintupgrade.py:165
msgid "Phase 2: Simulation and download"
msgstr "Fase 2: simulación e descarga"

#: usr/lib/linuxmint/mintupgrade/mintupgrade.py:166
msgid "Your package repositories will now point towards the new release."
msgstr "Os repositorios de paquetes pasarán agora a apuntar á nova versión."

#: usr/lib/linuxmint/mintupgrade/mintupgrade.py:166
msgid "A few more tests will be run and package updates will be downloaded."
msgstr ""
"Realizaranse algunhas comprobacións máis e descargaranse as actualizacións "
"dos paquetes."

#: usr/lib/linuxmint/mintupgrade/mintupgrade.py:172
msgid "Phase 3: Upgrade"
msgstr "Fase 3: anovación"

#: usr/lib/linuxmint/mintupgrade/mintupgrade.py:173
msgid "The packages will now be upgraded."
msgstr "Agora actualizaranse os paquetes."

#: usr/share/linuxmint/mintupgrade/mintupgrade.ui.h:3
msgid ""
"This program will ask you some questions and upgrade your operating system."
msgstr ""
"Este programa faralle algunhas preguntas e anovará o seu sistema operativo."

#: usr/share/linuxmint/mintupgrade/mintupgrade.ui.h:4
msgid "Let's go!"
msgstr "Imos aló!"

#: usr/share/linuxmint/mintupgrade/mintupgrade.ui.h:5
msgid "OK"
msgstr "Aceptar"

#: usr/share/linuxmint/mintupgrade/mintupgrade.ui.h:6
msgid "Fix"
msgstr "Corrixir"

#: usr/share/linuxmint/mintupgrade/mintupgrade.ui.h:7
msgid "Check again"
msgstr "Comprobar de novo"

#: usr/share/linuxmint/mintupgrade/mintupgrade.ui.h:8
msgid "The following error occurred:"
msgstr "Produciuse o seguinte erro:"

#: usr/share/linuxmint/mintupgrade/mintupgrade.ui.h:9
msgid "The upgrade was successful."
msgstr "A anovación completouse correctamente."

#: usr/share/linuxmint/mintupgrade/mintupgrade.ui.h:10
msgid "Reboot the computer for all the changes to take effect."
msgstr "Reinicie o equipo para que todos os cambios teñan efecto."

#: usr/share/linuxmint/mintupgrade/mintupgrade.ui.h:11
msgid "Recent Timeshift snapshot"
msgstr "Instantánea recente de Timeshift"

#: usr/share/linuxmint/mintupgrade/mintupgrade.ui.h:12
msgid "Applied software updates"
msgstr "Actualizacións de software aplicadas"

#: usr/share/linuxmint/mintupgrade/mintupgrade.ui.h:13
msgid ""
"These requirements are there to guarantee a safe upgrade. Only disable them "
"if you know what you are doing."
msgstr ""
"Estes requisitos serven para garantir unha anovación segura. Desactíveos só "
"se sabe o que está a facer."

#: usr/share/linuxmint/mintupgrade/mintupgrade.ui.h:14
msgid "Supported Linux Mint version"
msgstr "Versión admitida de Linux Mint"

#: usr/share/linuxmint/mintupgrade/mintupgrade.ui.h:15
msgid "Requirements"
msgstr "Requisitos"
